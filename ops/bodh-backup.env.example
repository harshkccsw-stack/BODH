# Configuration for bodh-db-backup.sh.
#
# Copy to /etc/bodh-backup.env on the production droplet:
#   install -m 600 -o root -g root bodh-backup.env.example /etc/bodh-backup.env
# then fill in the real values. NO SECRETS live in this file — the Spaces keys
# live in the s3cmd config named by S3CMD_CONFIG below.

# Name of the running MySQL container (see docker-compose.yml).
DB_CONTAINER=bodhpsychometric-mysql

# Where gzipped dumps are kept on the droplet.
BACKUP_DIR=/var/backups/bodhpsychometric

# DigitalOcean Space and key prefix. The Space must already exist — the script
# will not create it.
#
# storage-c9 is a SHARED Space (~3.4 GB of another product's reports, photos and
# templates). Backups are confined to the SPACES_PREFIX below, and the prune step
# only ever deletes keys under that prefix whose names match
# bodhpsychometric-<date>.sql.gz — verified with a non-backup object planted in
# the prefix, which survived. Keep it that way if you change the prune logic.
SPACES_BUCKET=storage-c9
SPACES_PREFIX=bodhpsychometric

# s3cmd config holding access_key/secret_key/host_base for sgp1. Root-only 0600.
S3CMD_CONFIG=/root/.s3cfg-bodh-backup

# Days of history kept, in BOTH the local directory and the Space.
RETENTION_DAYS=10

# Appended to on every run; rotated by /etc/logrotate.d/bodh-db-backup.
LOG_FILE=/var/log/bodh-db-backup.log

# Timezone for the filename stamp only — it does NOT schedule anything. The
# droplet's clock is UTC and Ubuntu cron ignores CRON_TZ, so the schedule is
# written in UTC (18:30 UTC = 00:00 IST) in /etc/cron.d/bodh-db-backup. Changing
# this value changes filenames; change the cron line to change the time.
BACKUP_TZ=Asia/Kolkata
