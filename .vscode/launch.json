{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "BodhassessApplication",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.bodhassess.BodhassessApplication",
            "projectName": "bodhassess-api",
            // Load APP_CORS_ALLOWED_ORIGINS / APP_UPLOADS_BASE_URL from the repo
            // .env so the debugged app uses the same origins as docker/run.sh
            // (and picks up edits on restart instead of a stale shell value).
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}