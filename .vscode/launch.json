{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "BodhpsychometricApplication",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.BodhpsychometricApplication",
            "projectName": "bodhpsychometric",
            // Both sides of a merge are kept: cwd AND envFile are needed.
            //
            // cwd — the app is a sub-project, so the launcher must start in
            // spring-social/ or application.yml's optional:file:./secrets.env
            // import resolves against the repository root and finds nothing.
            //
            // envFile carries MEMORYMESH_SYNC_KEY, which SyncKeyGuard compares
            // against the X-Sync-Key header MemoryMesh presents. Blank or unset
            // means 403 for every /api/sync/memorymesh/** call — an environment
            // that never set it up has nothing listening, rather than a door
            // with no lock. It must equal MemoryMesh's BODH_SYNC_KEY.
            //
            // An envFile, not an "env" block: this file is tracked in git and a
            // shared secret does not belong in it. secrets.env is gitignored,
            // and it lives in spring-social/, not at the repository root.
            "cwd": "${workspaceFolder}/spring-social",
            "envFile": "${workspaceFolder}/spring-social/secrets.env"
        },
        {
            "type": "java",
            "name": "ApiV2Application",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.bodhassess.v2.ApiV2Application",
            "projectName": "bodhassess-api-v2",
            "cwd": "${workspaceFolder}/bodhassess-api-v2",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3307/bodhassess_v2?createDatabaseIfNotExist=true",
                "DB_USER": "root",
                "DB_PASSWORD": "rootpw",
                "BOOTSTRAP_ADMIN_EMAIL": "superadmin@bodh.biz",
                "BOOTSTRAP_ADMIN_DOB": "1990-01-01"
            }
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "BodhassessApplication",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.bodhassess.BodhassessApplication",
            "projectName": "bodhassess-api",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}