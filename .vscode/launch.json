    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "BodhpsychometricApplication",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.BodhpsychometricApplication",
            "projectName": "bodhpsychometric"
        },
        {
            "type": "java",
            "name": "ApiV2Application",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.bodhassess.v2.ApiV2Application",
            "projectName": "bodhassess-api-v2",
            "cwd": "${workspaceFolder}/bodhassess-api-v2",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3307/bodhassess_v2?createDatabaseIfNotExist=true",
                "DB_USER": "root",
                "DB_PASSWORD": "rootpw",
                "BOOTSTRAP_ADMIN_EMAIL": "superadmin@bodh.biz",
                "BOOTSTRAP_ADMIN_DOB": "1990-01-01"
            }
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "BodhassessApplication",
            "request": "launch",
            "mainClass": "com.bodhpsychometric.bodhassess.BodhassessApplication",
            "projectName": "bodhassess-api",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}