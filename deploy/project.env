# Per-project constants for deploy/. Sourced by every deploy script, server
# and client side. This is the ONLY file that differs between the MemoryMesh
# and BodhAssess copies of deploy/ — everything else is byte-identical, so
# `diff -r` the two deploy/server directories to catch drift.
PROJECT=bodhassess
API_DIR=spring-social
IMAGE=bodhpsychometric-api
CONTAINER=bodhpsychometric-api
COMPOSE_SERVICE=api
COMPOSE_PROFILE=production
RUN_USER=bodh

# Health is polled from the HOST over the loopback publication, so the JRE
# image needs no curl. Releases built before actuator existed (the adopted
# legacy image) answer the legacy probe instead: POST {} to login is 400 when
# the servlet stack, JSON mapper and filter chain are all up, with no DB hit.
HEALTH_URL=http://127.0.0.1:8080/actuator/health
LEGACY_PROBE_URL=http://127.0.0.1:8080/api/auth/login
HEALTH_TIMEOUT=120
KEEP_RELEASES=5

# No SPAs here: admin.bodh.biz and portal.bodh.biz are on DigitalOcean App
# Platform, not on this droplet.
SPAS=""
WEB_ROOT=
WEB_HOST=

# One lock for the whole droplet, not per project: both stacks share 4 GB and
# must never restart two JVMs at the same moment.
LOCK_FILE=/var/lock/droplet-deploy.lock
