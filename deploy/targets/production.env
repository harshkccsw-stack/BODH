# Client-side deploy target: where deploy/client/push.sh sends artifacts.
# Non-secret on purpose, so it is tracked. Authentication is your SSH key.
DEPLOY_HOST=168.144.118.157
DEPLOY_USER=root
REMOTE_DIR=/root/bodhassess-api
# Extra ssh options, e.g. "-i ~/.ssh/droplet" or "-p 2222".
SSH_OPTS=

# Frontends on DigitalOcean App Platform (admin.bodh.biz, portal.bodh.biz).
# App Platform deploys them from the dist/ folders committed on GitHub, so
# push.sh builds them (npm run build:production — each SPA's .env.production),
# commits only those dist/ folders and pushes APP_PLATFORM_BRANCH, after the
# API's health gate. `push.sh all` = api + these. Set here, not in
# project.env, because project.env must stay identical to the droplet's copy.
APP_PLATFORM_SPAS="app portal"
APP_PLATFORM_BRANCH=main
SPA_app_DIR=bodhassess-app
SPA_portal_DIR=bodhassess-portal
