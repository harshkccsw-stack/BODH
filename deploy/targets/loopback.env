# Self-test target: run push.sh ON the droplet against itself, to prove the
# transport and the receiver without a developer machine. Needs a throwaway
# key in root's authorized_keys; SSH_OPTS names it.
DEPLOY_HOST=127.0.0.1
DEPLOY_USER=root
REMOTE_DIR=/root/bodhassess-api
SSH_OPTS="-i /root/.ssh/loopback-deploy -o StrictHostKeyChecking=accept-new"
