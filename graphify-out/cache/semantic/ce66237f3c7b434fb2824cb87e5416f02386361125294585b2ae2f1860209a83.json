{"nodes": [{"id": "_claude_skills_graphify_skill_graphify_pipeline", "label": "Graphify Knowledge Graph Pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "## What graphify is for", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn any folder of code, docs, papers, images, or video into a persistent queryable knowledge graph with an honest EXTRACTED/INFERRED/AMBIGUOUS audit trail; community detection surfaces cross-document connections you wouldn't think to ask about."}, {"id": "_claude_skills_graphify_skill_fast_path_query", "label": "Fast Path: Query Existing Graph", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "## What You Must Do When Invoked", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When graphify-out/graph.json already exists and the request is a natural-language question, skip the entire build pipeline and run graphify query immediately - the graph is already built, rebuilding wastes tokens and time."}, {"id": "_claude_skills_graphify_skill_ast_structural_extraction", "label": "AST Structural Extraction (Part A)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code is extracted deterministically via AST with no LLM and no API key - a code-only corpus skips semantic extraction entirely, so graphify never blocks on a key."}, {"id": "_claude_skills_graphify_skill_semantic_extraction", "label": "Semantic Extraction via Parallel Subagents (Part B)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 3 Part B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docs/papers/images are extracted by LLM subagents dispatched in parallel in a single message (5-10x faster than reading files one-by-one); must use general-purpose agents because read-only Explore agents cannot write chunk files, silently dropping results."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step B0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache is checked before dispatching any subagents so only uncached files cost tokens; stale .graphify_cached.json from prior runs is deleted so Part C never merges stale results."}, {"id": "_claude_skills_graphify_skill_community_detection", "label": "Community Detection and Labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4 / Step 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_god_nodes", "label": "God Nodes Analysis", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graph_health_check", "label": "Graph Health Check Gate", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only diagnostic before labeling that surfaces edge collapse, dangling/missing endpoints, and self-loops - the silent-corruption modes of incremental updates and AST/LLM id mismatches. Never aborts, but warnings must be surfaced per the Honesty Rules."}, {"id": "_claude_skills_graphify_skill_shrink_guard", "label": "Graph Shrink Guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json refuses to write a graph smaller than the existing graph.json, so an empty or failed extraction can never clobber a good graph, report, or analysis sidecar."}, {"id": "_claude_skills_graphify_skill_cost_tracker", "label": "Cumulative Token Cost Tracker", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step 9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Graphify Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "## Honesty Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS when unsure), never skip the corpus warning, always show token cost, show raw cohesion numbers, warn before visualizing >5000 nodes - the audit trail is the product."}], "edges": [{"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_extraction_spec_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "Step B2", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_query_query_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "## For /graphify query", "weight": 1.0}, {"source": "_claude_skills_graphify_skill_graphify_pipeline", "target": "_claude_skills_graphify_references_update_incremental_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": "## For --update and --cluster-only", "weight"