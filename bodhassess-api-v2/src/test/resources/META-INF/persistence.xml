        <class>com.bodhpsychometric.bodhassess.domain.assessment.DemographicFieldOption</class>
        <class>com.bodhpsychometric.bodhassess.domain.delivery.AssessmentSession</class>
        <class>com.bodhpsychometric.bodhassess.domain.delivery.AssessmentAttempt</class>
        <class>com.bodhpsychometric.bodhassess.domain.delivery.SessionAnswer</class>
        <class>com.bodhpsychometric.bodhassess.domain.delivery.SessionAnswerOption</class>
        <class>com.bodhpsychometric.bodhassess.domain.delivery.SessionTraitScore</class>
        <class>com.bodhpsychometric.bodhassess.domain.delivery.SessionDemographic</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
