# Baseline env — .env.local overrides for development, .env.production for
# prod builds. Only VITE_* vars reach the browser (this is a Vite app; the
# old NEXT_PUBLIC_* names here were never read).

VITE_API_URL=http://localhost:8080/api
VITE_APP_NAME=BodhAssess
VITE_AUTH_STORAGE_KEY=bodhassess.auth.token

# Frontend is served from https://admin.bodh.biz/dashboard in production,
# so the bundle must be built with VITE_BASE_PATH=/dashboard. Leave unset
# (or "/") for local dev served from the root.
VITE_BASE_PATH=/dashboard

# Origin of the respondent portal, used to build the registration links the
# organization wizard hands out (<origin>/register/{token}). No trailing slash.
#
# This is only the baseline. Vite's precedence is
# .env.[mode].local > .env.[mode] > .env.local > .env — so on any machine that
# has a .env.local (every dev box), THAT wins over this file and the value here
# never reaches a build. Every real mode therefore sets it explicitly in its own
# .env.[mode]; this line only covers a checkout with no .env.local at all.
VITE_PORTAL_URL=https://localhost:3002
