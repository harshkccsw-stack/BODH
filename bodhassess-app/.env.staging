# Staging build. Only VITE_* vars reach the browser (the old NEXT_PUBLIC_*
# names here were never read by this Vite app).

VITE_API_URL=https://api.bodh.biz/api
VITE_APP_NAME=BodhAssess
VITE_AUTH_STORAGE_KEY=bodhassess.auth.token

# Origin of the respondent portal — the registration links the organization
# wizard hands out are built as <origin>/register/{token}. Set here and not
# left to .env, because .env.local outranks .env in every mode: without this
# line a staging build made on a dev box emits http://localhost:3002 links.
# portal.bodh.biz is the only portal host in nginx/conf.d/default.conf; point
# it elsewhere if staging ever gets its own.
VITE_PORTAL_URL=https://portal.bodh.biz

# Optional: set only if the app is mounted under a sub-path.
# VITE_BASE_PATH=/bodh
