# Staging build. Only VITE_* vars reach the browser (the old NEXT_PUBLIC_*
# names here were never read by this Vite app).

VITE_API_URL=https://api.bodh.biz/api
VITE_APP_NAME=BodhAssess
VITE_AUTH_STORAGE_KEY=bodhassess.auth.token

# Optional: set only if the app is mounted under a sub-path.
# VITE_BASE_PATH=/bodh
