VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=BodhAssess
VITE_AUTH_STORAGE_KEY=bodhassess.auth.token

# Dev override — `.env` sets /dashboard for the prod deployment; locally
# we want the app served from the root.
VITE_BASE_PATH=/

# Respondent portal dev server (bodhassess-portal runs on :3002). This is
# already the built-in default, but kept explicit for clarity.
VITE_PORTAL_URL=http://localhost:3002
