# Copy to .env.local for development. Only VITE_* vars reach the browser.
#
# IMPORTANT: with no .env.local, config.ts defaults apiBase to
# https://api.bodh.biz/api, so a locally-run portal (port 3002) talks to the
# production backend and is rejected by its CORS allow-list.
VITE_API_URL=http://localhost:8080/api

VITE_APP_NAME=BodhAssess
VITE_AUTH_STORAGE_KEY=bodhassess.auth.token

# Sub-path mount; stays "/" on a dedicated subdomain like portal.bodh.biz.
VITE_BASE_PATH=/
