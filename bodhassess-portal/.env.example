# --- BodhAssess Respondent Portal -----------------------------------------
# All VITE_* vars are inlined at BUILD time. Rebuild after changing them.

# Full URL of the shared Spring backend, including the /api/v1 prefix.
VITE_API_URL=http://localhost:4000/api/v1

# Brand name shown in headers / titles.
VITE_APP_NAME=BodhAssess

# localStorage key for the respondent auth token. Kept identical to the
# admin app's portal key; safe because the portal runs on its own origin
# (separate subdomain → isolated localStorage, no collision).
VITE_AUTH_STORAGE_KEY=bodhassess.auth.token

# Sub-path mount. Empty / "/" means served at the domain root (the default
# for a dedicated subdomain such as portal.bodh.biz).
VITE_BASE_PATH=/
